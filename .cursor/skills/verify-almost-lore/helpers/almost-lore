#!/usr/bin/env node
/**
 * Drive a local Almost Lore `next dev` and capture reader-path evidence.
 * Run from the repo root. Never requests https://almostlore.com.
 *
 *   ALMOSTLORE_PORT=4321 ALMOSTLORE_HOST=127.0.0.1 \
 *     .cursor/skills/verify-almost-lore/helpers/almost-lore <command>
 */
"use strict";

const { spawn, execFileSync } = require("node:child_process");
const fs = require("node:fs");
const net = require("node:net");
const path = require("node:path");

