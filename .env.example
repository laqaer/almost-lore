PRODUCTS_KEY=
NEXT_PUBLIC_CHECKOUT_URL_PARTY_PACK=
NEXT_PUBLIC_CHECKOUT_URL_PARTY_PACK_OFFICE=
NEXT_PUBLIC_CHECKOUT_URL_CLASSROOM_PACK=
NEXT_PUBLIC_CHECKOUT_URL_CLASSROOM_DEPARTMENT=
NEXT_PUBLIC_CHECKOUT_URL_HALLOWEEN_PACK=

# Newsletter (pick one)
BUTTONDOWN_API_KEY=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
KIT_API_KEY=
KIT_FORM_ID=
NEWSLETTER_WEBHOOK_URL=

