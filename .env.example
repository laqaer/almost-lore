# Everything is optional: the site runs with none of these and degrades honestly.
# See ops/OWNER_SETUP.md for what each one switches on.

NEXT_PUBLIC_SITE_URL=https://almostlore.com

# Payments (either Stripe + PRODUCTS_KEY, or a hosted checkout URL per product)
