{
  "git": {
    "deploymentEnabled": {
      "infra/cloudflare-static-export": false,
      "infra/cloudflare-preview-workflow": false
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.almostlore.com" }],
      "destination": "https://almostlore.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://almost-lore-ops.laqaer-products.workers.dev/:path*"
    }
  ]
}
